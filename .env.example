# Backend proxy upstream URL (default: https://api-worky.vercel.app/api/v1)
# For local worky-backend development:
WORKY_API_URL="http://localhost:5000/api/v1"

# Client API base URL (optional; localhost:5000 and api-worky route via /api/worky proxy)
VITE_API_BASE_URL="http://localhost:5000/api/v1"
